{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Data quality KPIs",
      "queryLines": [
        "SELECT count_if(s.status = 'critical') AS critical_studies, count_if(s.status = 'warn') AS warn_studies, ",
        "sum(c.subjects_quarantined) AS subjects_quarantined, ",
        "round(100.0 * sum(c.subjects_quarantined) / nullif(sum(c.subjects_received), 0), 1) AS pct_quarantined ",
        "FROM dq_study_coverage c LEFT JOIN dq_study_status s ON s.study_id = c.study_id "
      ]
    },
    {
      "name": "ds_status",
      "displayName": "Quarantine by study",
      "queryLines": [
        "SELECT c.study_id, c.subjects_received, c.subjects_clean, c.subjects_quarantined, ",
        "round(100.0 * c.subjects_quarantined / nullif(c.subjects_received, 0), 1) AS pct_quarantined, ",
        "c.records_received, c.records_quarantined, coalesce(s.status, 'ok') AS status, s.breaches ",
        "FROM dq_study_coverage c LEFT JOIN dq_study_status s ON s.study_id = c.study_id ORDER BY c.study_id "
      ]
    },
    {
      "name": "ds_reasons",
      "displayName": "Quarantine reasons",
      "queryLines": [
        "SELECT study_id, concat(domain, '.', rule_id) AS rule, rule_description, severity, subjects_affected, issue_count ",
        "FROM gold_dq_summary WHERE action = 'quarantine' ORDER BY study_id, subjects_affected DESC "
      ]
    },
    {
      "name": "ds_trend",
      "displayName": "Quarantine trend",
      "queryLines": [
        "SELECT recorded_at, study_id, pct_subjects_quarantined, status FROM dq_run_history ORDER BY recorded_at "
      ]
    },
    {
      "name": "ds_thresholds",
      "displayName": "Threshold status",
      "queryLines": [
        "SELECT study_id, metric, value, warn, critical, status FROM dq_threshold_status ",
        "ORDER BY CASE status WHEN 'critical' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END, study_id, metric "
      ]
    },
    {
      "name": "ds_ai",
      "displayName": "AI data modelling attempts",
      "queryLines": [
        "SELECT recorded_at, study_id, submission_id, actor, attempt, scenario, accuracy_pct, threshold_pct, outcome, wrong_columns ",
        "FROM ai_modelling_runs ORDER BY recorded_at DESC, attempt DESC "
      ]
    },
    {
      "name": "ds_remediation",
      "displayName": "Remediation log",
      "queryLines": [
        "SELECT recorded_at, study_id, waivers_added, subjects_clean_before, subjects_clean_after, ",
        "subjects_quarantined_before, subjects_quarantined_after, unbalanced_domains FROM dq_remediation_log ORDER BY recorded_at DESC "
      ]
    }
  ],
